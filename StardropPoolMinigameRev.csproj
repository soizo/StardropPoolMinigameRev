<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableModDeploy>false</EnableModDeploy>
    <EnableModZip>false</EnableModZip>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="archived/**" />
    <EmbeddedResource Remove="archived/**" />
    <None Remove="archived/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.3.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="i18n\default.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="profile.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Tilesheets\stardropPool.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Tilesheets\upsidedown_emotes.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="DeployModAllowlist" AfterTargets="AfterBuild">
    <ItemGroup>
      <ModDeploymentContent Include="manifest.json;profile.json;i18n/**;Assets/**" />
    </ItemGroup>
    <MakeDir Directories="$(GameModsPath)/$(ModFolderName)" />
    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFiles="$(GameModsPath)/$(ModFolderName)/$(TargetName).dll"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(ModDeploymentContent)"
      DestinationFiles="@(ModDeploymentContent->'$(GameModsPath)/$(ModFolderName)/%(Identity)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="RemoveUnusedTilesheetFallbacks" BeforeTargets="AfterBuild">
    <Delete Files="$(TargetDir)Assets/Tilesheets/stardropPoolFont.png" />
  </Target>

</Project>
